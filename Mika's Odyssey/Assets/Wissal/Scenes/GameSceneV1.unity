  m_Script: {fileID: 11500000, guid: 0c86441f283560649a5defd416e0f995, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Planet2DialogueTrigger
  notStarted:
    name: Crowley
    sentences:
    - Hello. You are here to help? Perfect
    - I made the grave mistake of ordering these decorative rocks from Mochi. They
      are simply awful.
    - It's these 3 beside me. Could you please push them over into the pickup zone?
      It is indicated by a sign.
    - The rocks came in these big, annoying shipping containers. Please find all
      3 of them, too. They make for even worse decor.
  inProgress:
    name: Crowley
    sentences:
    - Place the rocks. Find the containers. Come see me after.
  complete:
    name: Crowley
    sentences:
    - Your help is appreciated. I will remember this.
    - You may leave now.
