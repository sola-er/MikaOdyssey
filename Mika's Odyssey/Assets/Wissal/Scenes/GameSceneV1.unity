MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1428046773}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 9614fc9e5e3e08e44b905da736daa5b5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::MochiDialogueTrigger
  notStarted:
    name: Mochi
    sentences:
    - Hello!
    - I'm pretty hungry. Go get me a piece of lettuce please.
    - It's on those platforms over there!
    - Shouldn't be too hard. Come back to see me if there's an issue.
  platformIsGone:
    name: Mochi
    sentences:
    - The lettuce got away?
    - Right... I forgot to warn you about that.
    - 'You could probably try jumping real high to get it. You''ll probably get in
      lost in space though. '
    - Go find a switch to get the platform back down instead. It should be in one
      of the constructions all over the planet.
  switchActivated:
    name: Mochi
    sentences:
    - You found the switch? Great!
    - What are you waiting for? Go get me my lettuce!
  complete:
    name: Mochi
    sentences:
    - My precious lettuce! Thank you.
    - 'Wait... Did you take a bite? How dare you... '
    - Hmph. I guess it's fine. Get out of here now. Mission complete or whatever.
